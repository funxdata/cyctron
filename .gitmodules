# 第三方子模块（合并说明：保留 developer 分支的 tab 缩进与 nng v1.12.0 分支，
# 同时采纳 libary 分支对 nng 测试的关闭策略，见根目录 CMakeLists.txt）
[submodule "crates/log"]
	path = crates/log
	url = git@github.com:rxi/log.c.git
[submodule "crates/mongoose"]
	path = crates/mongoose
	url = git@github.com:cesanta/mongoose.git
[submodule "crates/criterion"]
	path = crates/criterion
	url = git@github.com:Snaipe/Criterion.git
[submodule "crates/libffi"]
	path = crates/libffi
	url = git@github.com:libffi/libffi.git
[submodule "crates/zlog"]
	path = crates/zlog
	url = git@github.com:HardySimpson/zlog.git
[submodule "crates/nng"]
	path = crates/nng
	url = git@github.com:nanomsg/nng.git
	branch = v1.12.0
